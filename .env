# ---------------------------------------------------------------------------
# Streaming LLM Inference — configuration
# Leave a value blank to fall back to the documented default.
# ---------------------------------------------------------------------------

# --- Model -----------------------------------------------------------------
# Any HuggingFace causal LM: a hub id or a local path.
#   meta-llama/Llama-3.2-1B            base / completion model
#   meta-llama/Llama-3.2-1B-Instruct   chat model
#   Qwen/Qwen2.5-1.5B-Instruct, mistralai/Mistral-7B-Instruct-v0.3, ...
MODEL_ID=/models/<path-to-your-model>

# Required for gated repos. Meta's Llama models are gated: accept the license
# on the model page first, then create a token at huggingface.co/settings/tokens
HF_TOKEN=

# Only enable for checkpoints that ship custom modelling code and that you trust.
TRUST_REMOTE_CODE=false

# auto | bfloat16 | float16 | float32
# auto = bfloat16 on capable GPUs (how Meta ships Llama 3.2), float16 on older
# GPUs, float32 on CPU.
DTYPE=auto

# Passed straight to from_pretrained. "auto" shards across visible GPUs.
DEVICE_MAP=auto

# Optional: sdpa | flash_attention_2 | eager. Blank uses the library default.
ATTN_IMPLEMENTATION=

# --- Context ---------------------------------------------------------------
# Hard cap on prompt+history length. The server uses the smaller of this and
# the model's own limit. Keep it well below the advertised window: Llama 3.2
# advertises 128k, and a history that large will exhaust KV-cache memory on a
# small GPU long before the model objects.
MAX_CONTEXT_TOKENS=8192

# Slack reserved for template overhead when trimming history.
CONTEXT_MARGIN_TOKENS=64

# Injected only when the caller sends no system message of their own.
DEFAULT_SYSTEM_PROMPT=

# Extra stop strings applied ONLY to base models with no chat template, which
# otherwise keep writing both sides of the conversation.
FALLBACK_STOP_STRINGS=\nUser:,\nAssistant:

# --- Generation defaults ---------------------------------------------------
# Used when the request omits the field.
MAX_NEW_TOKENS=256
# Ceiling a caller may request. Bounds worst-case latency and memory.
MAX_NEW_TOKENS_LIMIT=2048

# Leave these BLANK to inherit each checkpoint's own generation_config.json —
# usually the right choice, since model authors tune them per release.
# Set TEMPERATURE=0 for deterministic greedy decoding.
TEMPERATURE=
TOP_P=
TOP_K=
REPETITION_PENALTY=

# Fixed RNG seed for reproducible sampling. Blank = nondeterministic.
SEED=

# --- Sessions --------------------------------------------------------------
# Server-side conversation memory, keyed by the request's session_id.
# Disable for a fully stateless service where clients send full history.
SESSION_ENABLED=true
SESSION_TTL_SECONDS=1800
SESSION_MAX_TURNS=40
SESSION_MAX_COUNT=1000

# --- Server ----------------------------------------------------------------
HOST=0.0.0.0
PORT=8000

# Concurrent generations. One model instance cannot safely serve two at once,
# so >1 only makes sense with a batching backend in front.
MAX_CONCURRENCY=1

# Seconds to wait for the generation thread to wind down after interruption.
GENERATION_JOIN_TIMEOUT=15

# Blank disables auth. SET THIS for anything reachable from the internet.
API_KEY=

CORS_ORIGINS=*

# --- Logging ---------------------------------------------------------------
LOG_LEVEL=INFO
# Logs full prompts at DEBUG. Off by default — prompts usually contain user data.
LOG_PROMPTS=false